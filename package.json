{
  "name": "francais-b2-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "法语词图（基础到 B2）：以 word-atlas 的界面与交互为基准，词条来自可追溯的教材索引与补充资料。",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "lint": "eslint src server/src",
    "css:check": "tsx scripts/check-css-tokens.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:ui": "node --import tsx --test \"src/**/*.test.tsx\"",
    "lexicon:import": "tsx scripts/import-lexicon.ts",
    "lexicon:freq": "python3 scripts/build-frequency.py",
    "lexicon:nouns": "python3 scripts/build-nouns.py",
    "lexicon:ipa": "python3 scripts/build-ipa.py",
    "lexicon:hl": "python3 scripts/build-highlights.py",
    "lexicon:conj": "tsx scripts/build-conjugations.ts",
    "lexicon:forms": "python3 scripts/build-forms.py",
    "lexicon:audio": "python3 -I scripts/build-audio.py",
    "lexicon:build": "tsx scripts/build-atlas.ts",
    "lexicon:grammar": "tsx scripts/build-grammar.ts",
    "lexicon:check": "tsx scripts/check-lexicon.ts",
    "lexicon:enrich-b2": "tsx scripts/enrich-b2-core.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:lexdb": "node scripts/e2e-lexdb.mjs",
    "e2e:gates": "node scripts/e2e-ci-gates.mjs",
    "lexicon:ids": "tsx scripts/check-id-stability.ts",
    "lexicon:families": "python3 scripts/build-families.py",
    "lexdb:build": "python3 -B scripts/lexdb/build-db.py",
    "lexdb:ai": "tsx scripts/lexdb/ai-run.ts",
    "lexdb:export": "python3 -B scripts/lexdb/export.py",
    "lexdb:check": "python3 -B scripts/lexdb/check.py",
    "lexdb:session": "tsx scripts/lexdb/session-batch.ts",
    "co:audio": "tsx scripts/build-co-audio.ts",
    "rfi:segments": "tsx scripts/build-rfi-segments.ts",
    "media:sync": "bash scripts/sync-media-blob.sh"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
