{"f":{"id":"f","w":"f","ipa":"ɛf","rank":3136,"pos":[{"p":"n.m.","g":"m","senses":[{"zh":"法郎（货币单位缩写）","fr":"Franc (unité monétaire).","src":["ai-reviewed"],"conf":1,"ex":[{"fr":"— F…-moi le camp ! lui dit Leuwen. Et toi, marche au galop, dit-il au postillon.","zh":"“给我滚蛋！”吕旺对他说。随后又对驿车夫说道：“你，快马加鞭！”","src":"ai-reviewed","hl":[2,3],"ref":"Stendhal, Lucien Leuwen, 1834"},{"fr":"— Ah ! il voulait te défendre ça… eh bien, tu te f… de lui parbleu !","zh":"“啊！他想禁止你做那事……哼，你当然压根儿不把他放在眼里！”","src":"ai-reviewed","hl":[49,51],"ref":"Rachilde, Monsieur Vénus, chapitre 9, 1884"},{"fr":"— Tu te f… de moi, dis… ?","zh":"“我说……你是在耍我吧？”","src":"ai-reviewed","hl":[8,10],"ref":"Jules Vallès, L’Enfant, G. Charpentier, 1889"}]}]},{"p":"v.","senses":[{"zh":"（粗俗动词 foutre 的委婉缩写）","fr":"de foutre.","reg":"俗","src":["ai-reviewed"],"conf":1}]}],"phrases":[{"fr":"100 F","zh":"100法郎","src":"ai-reviewed","conf":1},{"fr":"f... le camp","zh":"（委婉写法）滚蛋；开溜","src":"ai-reviewed","conf":1},{"fr":"se f... de","zh":"（委婉写法）不在乎；拿……开涮","src":"ai-reviewed","conf":1}],"frDefs":[{"p":"n.m.","gloss":"Franc (unité monétaire)."},{"p":"v.","gloss":"de foutre."}],"etym":"Du latin f.","sources":["ai-reviewed","lexique","wikt-fr"]}}