{"zut":{"id":"zut","w":"zut","ipa":"zyt","rank":4263,"pos":[{"p":"interj.","senses":[{"zh":"啧！靠！（表达懊恼，惊讶，不满的词，不算粗俗）","ex":[{"fr":"Ah ! zut alors…","zh":"哎呀！真倒霉……","src":"ai-reviewed","hl":[5,8]},{"fr":"Zut, j’ai taché mon pantalon.","zh":"哎呀，我把裤子弄脏了。","src":"ai-reviewed","hl":[0,3]},{"fr":"— Zut ! si l’on nous engueule, ce sera bien plus drôle…","zh":"——“管他呢！要是有人骂我们，那才更有意思呢……”","src":"ai-reviewed","hl":[2,5],"ref":"Émile Zola, Les Trois Villes : Paris, 1897"}],"src":["wikt-zh"],"conf":1},{"zh":"不！；休想！（表示拒绝）","fr":"Non, exprime le refus.","reg":"俗","src":["ai-reviewed"],"conf":1},{"zh":"呸！；切！（表示轻蔑）","fr":"Fi, exprime le mépris.","reg":"俗","src":["ai-reviewed"],"conf":1}]}],"phrases":[{"fr":"zut alors !","zh":"〈俗〉真倒霉！；可恶！；真是见鬼！","src":"ai-reviewed","conf":1},{"fr":"faire zut à quelqu'un","zh":"〈俗〉拒绝某人；对某人不屑一顾","src":"ai-reviewed","conf":1},{"fr":"et puis zut !","zh":"〈俗〉算了不管了！；爱咋咋地！","src":"ai-reviewed","conf":1}],"syn":["bordel","hélas","crotte"],"frDefs":[{"p":"interj.","gloss":"Exclamation qui exprime l’impatience, le dépit."},{"p":"interj.","gloss":"Non, exprime le refus."}],"etym":"Origine discutée :","sources":["ai-reviewed","lexique","wikt-fr","wikt-zh"]},"zurichois":{"id":"zurichois","w":"zurichois","ipa":"zyʁikwa","rank":33896,"forms":{"f":"zurichoise","fpl":"zurichoises"},"pos":[{"p":"adj.","senses":[{"zh":"苏黎世的","src":["ai-reviewed"],"conf":1}]},{"p":"n.m.","g":"m","senses":[{"zh":"苏黎世人；苏黎世方言","src":["ai-reviewed"],"conf":1}]}],"sources":["ai-reviewed","lexique","wikt-fr"]}}