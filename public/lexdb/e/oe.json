{"oeil":{"id":"oeil","w":"œil","ipa":"œj","level":"A1","rank":99,"atlasId":"oeil","forms":{"pl":"yeux"},"pos":[{"p":"n.m.","g":"m","senses":[{"zh":"眼睛（pl. yeux）","ex":[{"fr":"Armelle «a le soleil dans l'œil» (elle fait face au soleil).","zh":"阿梅尔「阳光照进眼睛」（她面朝太阳）。","src":"atlas","hl":[28,31]},{"fr":"Les Liméniennes ont toutes de belles couleurs, […], des yeux noirs d’une expression indéfinissable d’esprit, de fierté et de langueur.","zh":"利马的女子个个面色红润，[……]，一双黑眼睛流露出难以言喻的灵气、骄傲与慵懒神采。","src":"ai-reviewed","hl":[56,60],"ref":"Flora Tristan; Les Femmes de Lima, dans Revue de Paris, tome 32, 1836"},{"fr":"C’est un bel homme bien en chair, élégant en effet, quoique de massive encolure, avec de larges épaules, des joues pleines, de beaux yeux noirs caressans.","zh":"他是个身材丰满的美男子，虽说脖颈粗壮，却的确风度优雅，肩膀宽阔，双颊饱满，生着一双温存动人的黑眼睛。","src":"ai-reviewed","hl":[133,137],"ref":"Ernest Duvergier de Hauranne, Huit mois en Amérique, Revue des deux mondes, volume 2005, 1866, page 495"}],"src":["atlas","wikt-zh","omw"],"conf":3},{"zh":"眼，眼睛；(复数 œils) 字形（单个字符的渲染）；(复数 œils) 针眼","src":["wikt-zh","atlas","omw"],"conf":3},{"zh":"目","fr":"Organe permettant de voir","src":["wikt-zh","wikt-fr"],"conf":1},{"zh":"光学感应装置；电子眼","fr":"Élément d’une machine comportant un dispositif optique","src":["ai-reviewed"],"conf":1},{"zh":"目光；眼神；视线","fr":"Regard.","src":["ai-reviewed"],"conf":1},{"zh":"注意；关注；留心","fr":"Attention portée à quelque chose.","src":["ai-reviewed"],"conf":1},{"zh":"眼光；看法；观点；眼力","fr":"Jugement ; disposition d’esprit.","src":["ai-reviewed"],"conf":1}]}],"phrases":[{"fr":"coup d'œil","zh":"一瞥","src":"atlas","conf":3},{"fr":"à l'œil nu","zh":"肉眼","src":"atlas","conf":3},{"fr":"avoir l'œil sur","zh":"留意","src":"atlas","conf":3}],"syn":["mirette","calot","quinquet","coquillard"],"frDefs":[{"p":"n.m.","gloss":"Organe de la vue.","ex":"Les Liméniennes ont toutes de belles couleurs, […], des yeux noirs d’une express"},{"p":"n.m.","gloss":"Organe d’un animal, élément d’une machine, comportant un dispositif optiq