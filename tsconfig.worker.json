{
  // Cloudflare Worker (worker/) plus the sync core it bundles from server/src/lib. Kept apart from tsconfig.json so
  // DOM globals never reach worker code and Workers globals (R2Bucket, caches.default, ...) never reach src/.
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/worker-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "worker/**/*.ts",
    "server/src/lib/body-limit.ts",
    "server/src/lib/handlers.ts",
    "server/src/lib/store-types.ts"
  ]
}
