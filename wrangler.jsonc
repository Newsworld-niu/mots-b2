// Cloudflare Workers + Static Assets + R2 deployment for mots-b2.
// No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN from the environment.
// Build first with `npm run cf:build` (VITE_MEDIA_BASE_URL=/media strips offloaded audio/video from dist/).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mots-b2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Paths the Worker answers before static assets: the sync API, proxies, R2 media and SPA deep links.
    "run_worker_first": [
      "/api",
      "/api/*",
      "/dictionary-proxy",
      "/ai-proxy",
      "/ai-proxy/*",
      "/media/*",
      "/atlas/audio/*",
      "/lexdb/*",
      "/atlas",
      "/atlas/",
      "/dict",
      "/dict/*",
      "/learn",
      "/learn/",
      "/practice",
      "/practice/",
      "/mock",
      "/mock/",
      "/speak",
      "/speak/",
      "/listen",
      "/listen/",
      "/examread",
      "/examread/",
      "/essay",
      "/essay/",
      "/real",
      "/real/",
      "/drill",
      "/drill/",
      "/expr",
      "/expr/",
      "/reflow",
      "/reflow/",
      "/read",
      "/read/",
      "/conj",
      "/conj/",
      "/grammar",
      "/grammar/*",
      "/compare",
      "/compare/",
      "/me",
      "/me/",
      "/about",
      "/about/",
      "/decks",
      "/decks/",
      "/lounge",
      "/lounge/",
      "/w/*"
    ]
  },
  "r2_buckets": [
    { "binding": "SYNC_BUCKET", "bucket_name": "mots-b2-sync" },
    { "binding": "MEDIA_BUCKET", "bucket_name": "mots-b2-media" }
  ]
}
